# Stage 1: build
FROM node:22-alpine AS builder
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@11.0.8 --activate
COPY tools/infer-web/ .
# pnpm 11 allowBuilds (not committed; local dev uses package.json "pnpm.allowBuilds").
RUN printf 'allowBuilds:\n  esbuild: true\n' > pnpm-workspace.yaml \
  && pnpm install --frozen-lockfile \
  && pnpm run build

# Stage 2: serve
FROM nginx:1.27-alpine
COPY docker/nginx.infer-web.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html
EXPOSE 80
