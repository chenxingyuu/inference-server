# Stage 1: build
FROM node:22-alpine AS builder
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@9.15.4 --activate
COPY tools/infer-web/package.json tools/infer-web/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY tools/infer-web/ .
RUN pnpm run build

# Stage 2: serve
FROM nginx:1.27-alpine
COPY docker/nginx.infer-web.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html
EXPOSE 80
