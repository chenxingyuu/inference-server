# ── Stage 1: build ────────────────────────────────────────────────────────────
# Builder: full NGC TensorRT image (headers + toolchain).
# Runtime: CUDA runtime only + a minimal allowlisted TRT/cuDNN shared-lib set.
#
# Realistic SIZE on `docker images` after this: ~3.5–5.5GB (NOT Ascend-like ~1GB).
# CUDA 12.3 runtime alone is already ~2–3GB; OpenCV/FFmpeg/gRPC add more.
#
#   docker build \
#     --build-arg TRT_DEVEL_IMAGE=nvcr.io/nvidia/tensorrt:24.02-py3 \
#     --build-arg TRT_RUNTIME_IMAGE=nvcr.io/nvidia/cuda:12.3.2-runtime-ubuntu22.04 \
#     -f docker/Dockerfile.tensorrt .
#
# Prefer nvcr.io for CUDA: Docker Hub / Aliyun mirrors often lack the tag or
# return insufficient_scope when docker.io/nvidia/cuda is redirected.
ARG TRT_DEVEL_IMAGE=nvcr.io/nvidia/tensorrt:24.02-py3
ARG TRT_RUNTIME_IMAGE=nvcr.io/nvidia/cuda:12.3.2-runtime-ubuntu22.04
FROM ${TRT_DEVEL_IMAGE} AS builder
ARG APT_MIRROR=

ENV DEBIAN_FRONTEND=noninteractive
RUN if [ -n "${APT_MIRROR}" ]; then \
    sed -i "s|http://archive.ubuntu.com/ubuntu|${APT_MIRROR}|g; s|http://ports.ubuntu.com/ubuntu-ports|${APT_MIRROR}|g; s|http://security.ubuntu.com/ubuntu|${APT_MIRROR}|g" /etc/apt/sources.list; \
    fi && \
    apt-get update && apt-get install -y --no-install-recommends \
    python3-pip ninja-build pkg-config git \
    ccache \
    libssl-dev \
    libavcodec-dev libavformat-dev libavutil-dev libswscale-dev libavdevice-dev libavfilter-dev \
    libopencv-dev \
    libyaml-cpp-dev \
    nlohmann-json3-dev \
    libspdlog-dev \
    libboost-dev \
    librdkafka-dev \
    libgrpc++-dev \
    libprotobuf-dev \
    protobuf-compiler \
    protobuf-compiler-grpc \
    && pip3 install --no-cache-dir 'cmake>=3.24,<4' \
    && rm -rf /var/lib/apt/lists/*

ENV PATH="/usr/local/bin:${PATH}"

WORKDIR /src
COPY . .

RUN --mount=type=cache,target=/root/.cache/ccache,sharing=locked \
    cmake -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_CXX_COMPILER_LAUNCHER=ccache \
    -DBUILD_TRT_BACKEND=ON \
    -DBUILD_ASCEND_BACKEND=OFF \
    -DBUILD_ONNX_BACKEND=OFF \
    -DBUILD_REDIS_PUBLISHER=ON \
    -DBUILD_GRPC_PUBLISHER=ON \
    && cmake --build build --parallel $(nproc)

# Minimal TRT runtime closure for this binary:
# - Links only libnvinfer (+ cudart from CUDA base).
# - Loads prebuilt .engine via createInferRuntime/deserializeCudaEngine.
# - Does NOT call initLibNvInferPlugins → do not ship libnvinfer_plugin.
# - NEVER glob libnvinfer*.so* (matches libnvinfer_builder_resource, often >1GB).
# - NEVER cp -L (duplicates fat .so via every symlink name).
RUN set -eu; \
    mkdir -p /export/trt-libs /tmp/trt-seed; \
    ldd /src/build/infer_server | awk '/=>/ && $3 ~ /^\// {print $3}' > /tmp/trt-seed/ldd.txt; \
    : > /tmp/trt-seed/wanted.txt; \
    while IFS= read -r lib; do \
      case "$lib" in \
        *builder_resource*|*libnvinfer_builder*) continue ;; \
        *libnvinfer_plugin*|*libnvonnxparser*|*libnvparsers*) continue ;; \
        *libnvinfer*|*libcudnn*|*libmyelin*) printf '%s\n' "$lib" >> /tmp/trt-seed/wanted.txt ;; \
      esac; \
    done < /tmp/trt-seed/ldd.txt; \
    # One-level closure: also take NEEDED of each selected lib (cudnn split libs).
    cp /tmp/trt-seed/wanted.txt /tmp/trt-seed/frontier.txt; \
    while IFS= read -r lib; do \
      [ -e "$lib" ] || continue; \
      ldd "$lib" 2>/dev/null | awk '/=>/ && $3 ~ /^\// {print $3}' || true; \
    done < /tmp/trt-seed/frontier.txt | while IFS= read -r dep; do \
      case "$dep" in \
        *builder_resource*|*libnvinfer_builder*) continue ;; \
        *libnvinfer_plugin*|*libnvonnxparser*|*libnvparsers*) continue ;; \
        *libnvinfer*|*libcudnn*|*libmyelin*) printf '%s\n' "$dep" >> /tmp/trt-seed/wanted.txt ;; \
      esac; \
    done; \
    sort -u /tmp/trt-seed/wanted.txt -o /tmp/trt-seed/wanted.txt; \
    echo '--- seed libs ---'; cat /tmp/trt-seed/wanted.txt; \
    while IFS= read -r lib; do \
      [ -e "$lib" ] || { echo "missing: $lib" >&2; exit 1; }; \
      real="$(readlink -f "$lib")"; \
      base="$(basename "$real")"; \
      case "$base" in \
        *builder_resource*|*libnvinfer_builder*) echo "refusing builder lib: $base" >&2; exit 1 ;; \
      esac; \
      if [ -e "/export/trt-libs/$base" ]; then \
        # Same realpath basename already exported — OK.
        true; \
      else \
        cp -a "$real" "/export/trt-libs/$base"; \
      fi; \
      # Preserve the soname path that the loader asked for (if different).
      linkname="$(basename "$lib")"; \
      if [ "$linkname" != "$base" ] && [ ! -e "/export/trt-libs/$linkname" ]; then \
        ln -s "$base" "/export/trt-libs/$linkname"; \
      fi; \
    done < /tmp/trt-seed/wanted.txt; \
    echo '--- exported ---'; ls -lh /export/trt-libs; du -sm /export/trt-libs; \
    # Hard requirements
    ls /export/trt-libs/libnvinfer.so* >/dev/null; \
    ! ls /export/trt-libs/libnvinfer_builder_resource* >/dev/null 2>&1; \
    ! ls /export/trt-libs/libnvinfer_plugin* >/dev/null 2>&1; \
    # Fail closed if export is still suspiciously huge (builder/dupes likely).
    size_mb="$(du -sm /export/trt-libs | awk '{print $1}')"; \
    if [ "$size_mb" -gt 2500 ]; then \
      echo "export too large: ${size_mb}MB (expected <=2500 without builder_resource)" >&2; \
      exit 1; \
    fi

# ── Stage 2: runtime ──────────────────────────────────────────────────────────
ARG TRT_RUNTIME_IMAGE=nvcr.io/nvidia/cuda:12.3.2-runtime-ubuntu22.04
FROM ${TRT_RUNTIME_IMAGE}
ARG APT_MIRROR=

ENV DEBIAN_FRONTEND=noninteractive
ENV NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility,video

RUN if [ -n "${APT_MIRROR}" ]; then \
    sed -i "s|http://archive.ubuntu.com/ubuntu|${APT_MIRROR}|g; s|http://ports.ubuntu.com/ubuntu-ports|${APT_MIRROR}|g; s|http://security.ubuntu.com/ubuntu|${APT_MIRROR}|g" /etc/apt/sources.list; \
    fi && \
    apt-get update && apt-get install -y --no-install-recommends \
    libssl3 \
    libavcodec58 libavformat58 libavutil56 libswscale5 libavdevice58 libavfilter7 \
    libopencv-core4.5d libopencv-imgproc4.5d libopencv-imgcodecs4.5d libopencv-videoio4.5d \
    libyaml-cpp0.7 \
    librdkafka1 \
    libspdlog1 \
    libgrpc++1 \
    libprotobuf23 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /export/trt-libs/ /usr/local/lib/
COPY --from=builder /src/build/infer_server /usr/local/bin/infer_server
COPY --from=builder /src/build/_deps/hiredis-build/libhiredis.so* /usr/local/lib/
RUN echo '/usr/local/lib' > /etc/ld.so.conf.d/infer-local.conf && ldconfig && \
    ldd /usr/local/bin/infer_server | tee /tmp/infer_server.ldd && \
    ! grep -q 'not found' /tmp/infer_server.ldd && \
    ldconfig -p | grep -E 'libnvinfer\.so' >/dev/null

VOLUME ["/models", "/config"]
ENTRYPOINT ["/usr/local/bin/infer_server", "/config/config.yaml"]
