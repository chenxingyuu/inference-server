# ── Stage 1: build ────────────────────────────────────────────────────────────
# Builder uses the official TensorRT image (headers + full CUDA toolkit).
# Runtime uses a slim CUDA base and only copies TRT/cuDNN shared libs needed
# to run serialized .engine files.
#   docker build \
#     --build-arg TRT_DEVEL_IMAGE=nvcr.io/nvidia/tensorrt:24.02-py3 \
#     --build-arg TRT_RUNTIME_IMAGE=nvcr.io/nvidia/cuda:12.3.2-runtime-ubuntu22.04 \
#     -f docker/Dockerfile.tensorrt .
# Prefer nvcr.io for CUDA runtime: Docker Hub / Aliyun mirrors often lack this tag
# or return insufficient_scope when docker.io/nvidia/cuda is redirected.
ARG TRT_DEVEL_IMAGE=nvcr.io/nvidia/tensorrt:24.02-py3
ARG TRT_RUNTIME_IMAGE=nvcr.io/nvidia/cuda:12.3.2-runtime-ubuntu22.04
FROM ${TRT_DEVEL_IMAGE} AS builder
ARG APT_MIRROR=

ENV DEBIAN_FRONTEND=noninteractive
RUN if [ -n "${APT_MIRROR}" ]; then \
    sed -i "s|http://archive.ubuntu.com/ubuntu|${APT_MIRROR}|g; s|http://ports.ubuntu.com/ubuntu-ports|${APT_MIRROR}|g; s|http://security.ubuntu.com/ubuntu|${APT_MIRROR}|g" /etc/apt/sources.list; \
    fi && \
    apt-get update && apt-get install -y --no-install-recommends \
    python3-pip ninja-build pkg-config git \
    ccache \
    libssl-dev \
    libavcodec-dev libavformat-dev libavutil-dev libswscale-dev libavdevice-dev libavfilter-dev \
    libopencv-dev \
    libyaml-cpp-dev \
    nlohmann-json3-dev \
    libspdlog-dev \
    libboost-dev \
    librdkafka-dev \
    libgrpc++-dev \
    libprotobuf-dev \
    protobuf-compiler \
    protobuf-compiler-grpc \
    && pip3 install --no-cache-dir 'cmake>=3.24,<4' \
    && rm -rf /var/lib/apt/lists/*

ENV PATH="/usr/local/bin:${PATH}"

WORKDIR /src
COPY . .

RUN --mount=type=cache,target=/root/.cache/ccache,sharing=locked \
    cmake -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_CXX_COMPILER_LAUNCHER=ccache \
    -DBUILD_TRT_BACKEND=ON \
    -DBUILD_ASCEND_BACKEND=OFF \
    -DBUILD_ONNX_BACKEND=OFF \
    -DBUILD_REDIS_PUBLISHER=ON \
    -DBUILD_GRPC_PUBLISHER=ON \
    && cmake --build build --parallel $(nproc)

# Export TensorRT / cuDNN / related runtime .so files (not present on slim CUDA base).
# Prefer packaging by soname from the linked binary, then add common plugin libs.
RUN mkdir -p /export/trt-libs && \
    ldd /src/build/infer_server | awk '/=>/ && $3 ~ /^\// {print $3}' | sort -u \
      | while read -r lib; do \
          case "$lib" in \
            *libnvinfer*|*libnvonnxparser*|*libnvparsers*|*libnvinfer_plugin*|*libcudnn*|*libmyelin*) \
              cp -aL "$lib" /export/trt-libs/ ;; \
          esac; \
        done && \
    for pattern in \
        '/usr/lib/x86_64-linux-gnu/libnvinfer*.so*' \
        '/usr/lib/x86_64-linux-gnu/libnvinfer_plugin*.so*' \
        '/usr/lib/x86_64-linux-gnu/libnvonnxparser*.so*' \
        '/usr/lib/x86_64-linux-gnu/libnvparsers*.so*' \
        '/usr/lib/x86_64-linux-gnu/libcudnn*.so*' \
        '/usr/local/tensorrt/lib/libnvinfer*.so*' \
        '/usr/local/tensorrt/lib/libnvinfer_plugin*.so*' \
        '/opt/tensorrt/lib/libnvinfer*.so*' \
        '/opt/tensorrt/lib/libnvinfer_plugin*.so*'; do \
      for f in $pattern; do \
        [ -e "$f" ] || continue; \
        cp -aL "$f" /export/trt-libs/ 2>/dev/null || true; \
      done; \
    done && \
    ls -la /export/trt-libs && \
    test -n "$(ls -A /export/trt-libs)"

# ── Stage 2: runtime ──────────────────────────────────────────────────────────
ARG TRT_RUNTIME_IMAGE=nvcr.io/nvidia/cuda:12.3.2-runtime-ubuntu22.04
FROM ${TRT_RUNTIME_IMAGE}
ARG APT_MIRROR=

ENV DEBIAN_FRONTEND=noninteractive
# Match NGC TensorRT containers: expose GPU compute + video decode to the process.
ENV NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility,video

RUN if [ -n "${APT_MIRROR}" ]; then \
    sed -i "s|http://archive.ubuntu.com/ubuntu|${APT_MIRROR}|g; s|http://ports.ubuntu.com/ubuntu-ports|${APT_MIRROR}|g; s|http://security.ubuntu.com/ubuntu|${APT_MIRROR}|g" /etc/apt/sources.list; \
    fi && \
    apt-get update && apt-get install -y --no-install-recommends \
    libssl3 \
    libavcodec58 libavformat58 libavutil56 libswscale5 libavdevice58 libavfilter7 \
    libopencv-core4.5d libopencv-imgproc4.5d libopencv-imgcodecs4.5d libopencv-videoio4.5d \
    libyaml-cpp0.7 \
    librdkafka1 \
    libspdlog1 \
    libgrpc++1 \
    libprotobuf23 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /export/trt-libs/ /usr/local/lib/
COPY --from=builder /src/build/infer_server /usr/local/bin/infer_server
# hiredis is FetchContent-built when BUILD_REDIS_PUBLISHER=ON; not in apt runtime packages
COPY --from=builder /src/build/_deps/hiredis-build/libhiredis.so* /usr/local/lib/
RUN echo '/usr/local/lib' > /etc/ld.so.conf.d/infer-local.conf && ldconfig

VOLUME ["/models", "/config"]
ENTRYPOINT ["/usr/local/bin/infer_server", "/config/config.yaml"]
