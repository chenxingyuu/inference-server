# ── Stage 1: build ────────────────────────────────────────────────────────────
# Base images can be overridden at build time:
#   docker build \
#     --build-arg CUDA_DEVEL_IMAGE=... \
#     --build-arg CUDA_RUNTIME_IMAGE=... \
#     -f docker/Dockerfile.tensorrt .
ARG CUDA_DEVEL_IMAGE=nvidia/cuda:12.4.1-devel-ubuntu22.04
ARG CUDA_RUNTIME_IMAGE=nvidia/cuda:12.4.1-runtime-ubuntu22.04
FROM ${CUDA_DEVEL_IMAGE} AS builder
ARG APT_MIRROR=

ENV DEBIAN_FRONTEND=noninteractive
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    if [ -n "${APT_MIRROR}" ]; then \
    sed -i "s|http://archive.ubuntu.com/ubuntu|${APT_MIRROR}|g; s|http://ports.ubuntu.com/ubuntu-ports|${APT_MIRROR}|g; s|http://security.ubuntu.com/ubuntu|${APT_MIRROR}|g" /etc/apt/sources.list; \
    fi && \
    apt-get update && apt-get install -y --no-install-recommends \
    cmake ninja-build pkg-config git \
    ccache \
    libssl-dev \
    libavcodec-dev libavformat-dev libavutil-dev libswscale-dev \
    libopencv-dev \
    libyaml-cpp-dev \
    nlohmann-json3-dev \
    libspdlog-dev \
    libboost-dev \
    librdkafka-dev \
    && rm -rf /var/lib/apt/lists/*

# TensorRT is expected to be mounted/installed via NVIDIA container runtime.
# If using a fixed TRT version, install it here:
# COPY --from=nvcr.io/nvidia/tensorrt:24.02-py3 /usr/lib/x86_64-linux-gnu/libnvinfer* /usr/lib/x86_64-linux-gnu/
# COPY --from=nvcr.io/nvidia/tensorrt:24.02-py3 /usr/include/x86_64-linux-gnu/NvInfer.h /usr/include/

WORKDIR /src
COPY . .

RUN --mount=type=cache,target=/root/.cache/ccache,sharing=locked \
    cmake -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_CXX_COMPILER_LAUNCHER=ccache \
    -DBUILD_TRT_BACKEND=ON \
    -DBUILD_ASCEND_BACKEND=OFF \
    && cmake --build build --parallel $(nproc)

# ── Stage 2: runtime ──────────────────────────────────────────────────────────
FROM ${CUDA_RUNTIME_IMAGE}
ARG APT_MIRROR=

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    if [ -n "${APT_MIRROR}" ]; then \
    sed -i "s|http://archive.ubuntu.com/ubuntu|${APT_MIRROR}|g; s|http://ports.ubuntu.com/ubuntu-ports|${APT_MIRROR}|g; s|http://security.ubuntu.com/ubuntu|${APT_MIRROR}|g" /etc/apt/sources.list; \
    fi && \
    apt-get update && apt-get install -y --no-install-recommends \
    libssl3 \
    libavcodec58 libavformat58 libavutil56 libswscale5 \
    libopencv-core4.5d libopencv-imgproc4.5d \
    libyaml-cpp0.7 \
    librdkafka1 \
    libspdlog1 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /src/build/infer_server /usr/local/bin/infer_server

VOLUME ["/models", "/config"]
ENTRYPOINT ["/usr/local/bin/infer_server", "/config/config.yaml"]
